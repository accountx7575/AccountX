# AccountX frontend environment
# Copy to .env and fill in real values. NEVER commit .env.

# Supabase project (Project Settings -> API) - the ONLY two vars the app reads.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ----------------------------------------------------------------------------
# IMPORTANT - AI / Email / WhatsApp provider keys are NOT frontend env vars.
# They are configured as Supabase Edge Function secrets (deploy-time config):
#
#   supabase secrets set AI_PROVIDER=...                  # openai | anthropic (default: openai)
#   supabase secrets set AI_MODEL=...                     # default: gpt-4o-mini / claude-3-5-haiku-latest
#   supabase secrets set OPENAI_API_KEY=...               # when AI_PROVIDER=openai
#   supabase secrets set ANTHROPIC_API_KEY=...            # when AI_PROVIDER=anthropic
#   supabase secrets set EMAIL_PROVIDER=resend            # 'smtp' is a documented stub in this build
#   supabase secrets set RESEND_API_KEY=...
#   supabase secrets set NOTIFICATIONS_FROM=...           # falls back to SMTP_FROM when unset
#   supabase secrets set SMTP_FROM=...
#   supabase secrets set WHATSAPP_PROVIDER=meta_cloud
#   supabase secrets set WHATSAPP_ACCESS_TOKEN=...
#   supabase secrets set WHATSAPP_PHONE_NUMBER_ID=...
#   supabase secrets set WHATSAPP_BUSINESS_ACCOUNT_ID=... # reserved (listed for parity; not read yet)
#
# These run server-side inside supabase/functions/* and must never be exposed
# to the browser bundle. Do NOT add them to this file or any VITE_* variable.
# ----------------------------------------------------------------------------
